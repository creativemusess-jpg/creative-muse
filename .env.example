VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase key for transactional email logging and secure admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email provider. Supported: resend, development_log
TRANSACTIONAL_EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Creative Muse Fine Jewellery <order@creativemusee.com>"

# Safe email test mode.
# Production: EMAIL_TEST_MODE=false
# Local development: EMAIL_TEST_MODE=true (redirects all emails to EMAIL_TEST_RECIPIENT)
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=admin@creativemusee.com

# Production website URL for email links
SITE_URL=https://www.creativemusee.com